# Local development environment variables
# Copy to .env.local to customize local development.
# Set J26_SIGNUPINFO_UPSTREAM only if you need to override the default (localhost:8000).

# Local development runs the app at the root path.
# Override only if you explicitly want to emulate the deployed subpath locally.
J26_SERVICE_BASE_PATH=/

# Same-origin prefix that points to the signupinfo backend.
# Defaults to /_services/signupinfo (production path). Override for local dev if needed.
#J26_SIGNUPINFO_PROXY_PREFIX=/_services/signupinfo

# Optional override for the local backend in development.
J26_SIGNUPINFO_UPSTREAM=http://localhost:8000
